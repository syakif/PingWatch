{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Hangfire": "Information"
    }
  },
  "PingWatch": {
    "CheckCronExpression": "*/1 * * * *",
    "HttpTimeoutSeconds": 10
  }
}
